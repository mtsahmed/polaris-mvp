# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the app runs; used in email confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API: console.anthropic.com → API keys. Server-side only. Always tried first.
ANTHROPIC_API_KEY=

# OpenAI fallback (optional): used only when Claude is unavailable
# (bad key, no credit, rate limit, outage). platform.openai.com → API keys.
OPENAI_API_KEY=
# OpenAI models in the order they are tried; each must be enabled for your key.
# Prices for the cost log live in src/lib/ai/providers/openai.ts (PRICING); a model
# not listed there is logged with no cost.
OPENAI_MODELS=gpt-6.1-sol,gpt-5.5
